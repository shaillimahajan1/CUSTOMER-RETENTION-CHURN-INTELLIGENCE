# Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Database configuration (DuckDB local file or Postgres)
DATABASE_TYPE=duckdb
DUCKDB_PATH=data/processed/customer_retention.duckdb

# Optional Postgres settings (if connecting to remote Postgres warehouse)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=customer_churn
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password_here

# Pipeline Settings
RANDOM_STATE=42
LOG_LEVEL=INFO
MODEL_OPTIMIZATION_METRIC=pr_auc
DEFAULT_DECISION_THRESHOLD=0.38
